# Stock Screener Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Database (Supabase)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/[project]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# JWT Secret for auth validation (optional, for backend)
# Get from: Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# =============================================================================
# OPTIONAL: Korean Stock Data Collection
# =============================================================================
# KIS API (Korea Investment & Securities)
# Get from: https://apiportal.koreainvestment.com
# Provides: PER, PBR, EPS, BPS, 52-week high/low, market cap
KIS_APP_KEY=
KIS_APP_SECRET=

# DART API (Financial Supervisory Service)
# Get from: https://opendart.fss.or.kr (free registration)
# Provides: ROA, PS Ratio, EV/EBITDA (calculated from financial statements)
DART_API_KEY=

# =============================================================================
# OPTIONAL: Discord Bot
# =============================================================================
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Backend API URL for Discord bot (default: http://localhost:8000)
API_BASE_URL=https://stock-screener-api-c0kc.onrender.com

# =============================================================================
# OPTIONAL: Tuning Parameters
# =============================================================================
# KR Pipeline Settings (defaults shown)
# KR_FDR_TIMEOUT=10.0
# KR_NAVER_TIMEOUT=5.0
# KR_KIS_TIMEOUT=10.0
# KR_HISTORY_BATCH_SIZE=50
# KR_METRICS_BATCH_SIZE=50
# KR_MAX_WORKERS=4
# KR_MAX_RETRIES=2

# US Pipeline Settings (defaults shown)
# US_DOWNLOAD_TIMEOUT=120.0
# US_INFO_TIMEOUT=30.0
# US_PRICE_BATCH_SIZE=100
# US_HISTORY_BATCH_SIZE=100
# US_METRICS_BATCH_SIZE=20
# US_MAX_WORKERS=6
# US_BATCH_DELAY=1.5
# US_BATCH_JITTER=0.5
# US_MAX_RETRIES=3

# =============================================================================
# OPTIONAL: Debug/Development
# =============================================================================
# DEBUG=false
